{
  "name": "@lostintangent/leafnode",
  "version": "0.0.1",
  "description": "A React-based JSON editor for human<->agent collaboration",
  "license": "MIT",
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --hot playground/index.html --hostname=0.0.0.0 --port=3004",
    "build:dev": "bun run scripts/build/build.ts",
    "build:prod": "bun run scripts/build/build.ts --prod",
    "build:playground": "bun run scripts/build/build.ts --playground",
    "prepublishOnly": "bun build:prod",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun test",
    "benchmark": "bun run scripts/benchmark/benchmark.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/store": "^0.11.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-plugin-tailwind": "^0.1.2",
    "dts-bundle-generator": "^9.5.1",
    "lucide-react": "^1.28.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/store": "^0.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
