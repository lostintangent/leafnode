{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "parsely": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["playground", "scripts", "src", "test"]
}
